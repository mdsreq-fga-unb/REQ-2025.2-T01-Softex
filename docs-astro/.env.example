# ============================================
# VARIÁVEIS DE AMBIENTE - DOCS (Astro)
# ============================================
# Copie este arquivo para .env na pasta docs-astro/ e preencha com os valores corretos

# URL base do site (usado no build)
# ASTRO_SITE_URL=https://mdsreq-fga-unb.github.io

# Base path do site
# ASTRO_BASE_PATH=/REQ-2025.2-T01-Softex

# Porta do servidor de desenvolvimento
# ASTRO_PORT=4321

# Ambiente de execução
NODE_ENV=development

# Nota: As configurações principais do Astro estão em astro.config.mjs
# Este arquivo é para variáveis de ambiente adicionais se necessário
