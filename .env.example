# ============================================
# VARIÁVEIS DE AMBIENTE - PROJETO SOFTEX
# ============================================
# Copie este arquivo para .env e preencha com os valores corretos
# NUNCA commite o arquivo .env no repositório!

# ============================================
# BACKEND (Django)
# ============================================

# Chave secreta do Django (OBRIGATÓRIA)
# Gere uma nova chave com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Modo de debug (True/False)
# Em produção, SEMPRE defina como False
DEBUG=True

# Hosts permitidos (separados por vírgula)
# Em produção, defina os domínios permitidos: exemplo.com,www.exemplo.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Configuração do Banco de Dados
# Opção 1: SQLite (desenvolvimento)
# DATABASE_ENGINE=django.db.backends.sqlite3
# DATABASE_NAME=db.sqlite3

# Opção 2: PostgreSQL (produção)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=softex_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Ou use DATABASE_URL (formato: postgres://user:password@host:port/dbname)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/softex_db

# Configurações de CORS (Cross-Origin Resource Sharing)
# Em produção, defina apenas os domínios permitidos
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=True

# Configurações de Time Zone e Idioma
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# ============================================
# FRONTEND (Vue.js)
# ============================================

# URL da API Backend
# Para Vue CLI: VUE_APP_API_URL
# Para Vite: VITE_API_URL
VUE_APP_API_URL=http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# Porta do servidor de desenvolvimento do frontend
VUE_APP_PORT=8080
VITE_PORT=5173

# Modo de produção (true/false)
NODE_ENV=development

# ============================================
# DOCS (Astro/Starlight)
# ============================================

# URL base do site (usado no build)
ASTRO_SITE_URL=https://mdsreq-fga-unb.github.io
ASTRO_BASE_PATH=/REQ-2025.2-T01-Softex

# Porta do servidor de desenvolvimento
ASTRO_PORT=4321

# ============================================
# CONFIGURAÇÕES GERAIS
# ============================================

# Ambiente de execução (development, staging, production)
ENVIRONMENT=development

# Logs
LOG_LEVEL=DEBUG

# ============================================
# CONFIGURAÇÕES OPCIONAIS
# ============================================

# Email (se usar envio de emails)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Redis (se usar cache ou filas)
# REDIS_URL=redis://localhost:6379/0

# Celery (se usar tarefas assíncronas)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
