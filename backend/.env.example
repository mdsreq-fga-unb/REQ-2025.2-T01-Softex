# ======================================
# CONFIGURAÇÕES DO DJANGO
# ======================================

# Chave secreta do Django (gere uma nova com o comando abaixo)
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=sua-chave-secreta-aqui-MUDE-ISSO

# Modo de desenvolvimento (True para dev, False para produção)
DEBUG=True

# ======================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ======================================

# Nome do banco de dados PostgreSQL que você criou
DB_NAME=nome_do_seu_banco

# Usuário do PostgreSQL
DB_USER=postgres

# Senha do PostgreSQL que você definiu na instalação
DB_PASSWORD=sua_senha_aqui

# Host do banco (localhost se estiver na mesma máquina)
DB_HOST=localhost

# Porta do PostgreSQL (padrão: 5432)
DB_PORT=5432
