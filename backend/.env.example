﻿# ============================================
# VARIÁVEIS DE AMBIENTE - BACKEND (Django)
# ============================================
# Copie este arquivo para .env na pasta backend/ e preencha com os valores corretos

# Chave secreta do Django (OBRIGATÓRIA)
DJANGO_SECRET_KEY=your-secret-key-here

# Modo de debug (True/False)
DEBUG=True

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1

# Configuração do Banco de Dados - PostgreSQL
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=softex_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Ou use DATABASE_URL (formato: postgres://user:password@host:port/dbname)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/softex_db

# Configurações de CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=True

# Time Zone e Idioma
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

